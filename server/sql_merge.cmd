@echo off
powershell -Command "if (Test-Path 'tables.sql') { Remove-Item 'tables.sql' }; Get-ChildItem -Path . -Filter tables.sql -Recurse -File | Where-Object { $_.FullName -notmatch '\\tables\.sql$' -or $_.Directory.Name -ne (Get-Location).Path.Split('\\')[-1] } | Sort-Object FullName | ForEach-Object { Add-Content 'tables.sql' ('-- ---------- ' + $_.FullName + ' ------------'); Get-Content $_.FullName | Add-Content 'tables.sql'; Add-Content 'tables.sql' ('-- ---------- ' + $_.FullName + ' ------------') }"